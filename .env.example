# Copy to .env and fill in. docker-compose reads this file's vars for substitution.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=online_judge

# --- Backend ---
PORT=3000
NODE_ENV=development

# For host (non-Docker) runs, point at localhost.
# docker-compose overrides DATABASE_URL to the `db` service host automatically.
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/online_judge?schema=public

# --- JWT (use 32+ random chars in production) ---
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# --- Logging (optional) ---
# LOG_LEVEL=info
